  clinic   Clinic @relation(fields: [clinicId], references: [id])
  patientId String
  patient   Patient         @relation(fields: [patientId], references: [id])
  fecha     DateTime        @default(now())
  items     TreatmentItem[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  /// NOM-004-SSA3-2012 5.10: who wrote the note and who signed it (electronic signature with the
  /// author's signing PIN). The signer's name, title and licence are frozen at signing, with a
  /// SHA-256 of the note's content. Editing a signed note voids the signature. `legacyRecord` marks
  /// notes written before electronic signatures existed; they are never signed retroactively.
  createdById   String?
  signedById    String?
  signedAt      DateTime?
  signedHash    String?
  signerName    String?
  signerTitle   String?
  signerLicense String?
  legacyRecord  Boolean   @default(false)

  @@index([patientId])
  @@index([clinicId])
  @@index([createdById, signedAt])
}

model TreatmentItem {
  id              String                 @id @default(uuid())
  /// The clinic this row belongs to. Every query on this model is scoped to the current clinic
  /// (see apps/api/src/lib/tenancy). The database default reads the session's app.clinic_id and
  /// fails when it is unset, so an insert that bypasses the scoped client cannot create a row that
  /// belongs to no clinic.
  clinicId String @default(dbgenerated("current_setting('app.clinic_id'::text)"))
  clinic   Clinic @relation(fields: [clinicId], references: [id])
  treatmentId     String
  treatment       Treatment              @relation(fields: [treatmentId], references: [id])
  treatmentTypeId String
  treatmentType   TreatmentType          @relation(fields: [treatmentTypeId], references: [id])
  notes           String?
  consent         Consent?
  diagrams        TreatmentItemDiagram[]
  photos          TreatmentItemPhoto[]
  products        TreatmentItemProduct[]

  @@unique([treatmentId, treatmentTypeId])
  @@index([clinicId])
}

enum ConsentSignatureMethod {
  DIGITAL
  PAPER
}

model Consent {
  id                        String                 @id @default(uuid())
  /// The clinic this row belongs to. Every query on this model is scoped to the current clinic
  /// (see apps/api/src/lib/tenancy). The database default reads the session's app.clinic_id and
  /// fails when it is unset, so an insert that bypasses the scoped client cannot create a row that
  /// belongs to no clinic.
  clinicId String @default(dbgenerated("current_setting('app.clinic_id'::text)"))
  clinic   Clinic @relation(fields: [clinicId], references: [id])
  treatmentItemId           String                 @unique
  treatmentItem             TreatmentItem          @relation(fields: [treatmentItemId], references: [id])
  signatureMethod           ConsentSignatureMethod @default(DIGITAL)
  scanId                    String?
  scan                      ConsentScan?           @relation(fields: [scanId], references: [id])
  place                     String
  signedDateSnapshot        String
  patientNameSnapshot       String
  patientIdentification     String
  clinicNameSnapshot        String
  doctorTitleSnapshot       String
  doctorNameSnapshot        String
  doctorLicenseSnapshot     String
  declarationBeforeSnapshot String
  declarationAfterSnapshot  String
  sections                  Json
  patientSignatureImagePath String?
  witnessName               String?
  witnessSignatureImagePath String?
  /// NOM-004-SSA3-2012 10.1.1 asks for two witnesses. Null on consents signed before both were
  /// required, which keep the one witness they were signed with.
  secondWitnessName               String?
  secondWitnessSignatureImagePath String?
  /// The contingencies clause (10.1.1: authorization to attend contingencies and emergencies that
  /// arise from the act), frozen as printed. Null on consents signed before it was added.
  contingencyClauseSnapshot       String?
  signedAt                  DateTime               @default(now())

  @@index([scanId])
  @@index([clinicId])
}

/// One scanned (photographed) set of pages carrying the handwritten signatures of one or more
/// consents signed the same day. `patientId` is a plain column, like TreatmentItemPhoto's.
model ConsentScan {
  id         String            @id @default(uuid())
  /// The clinic this row belongs to. Every query on this model is scoped to the current clinic
  /// (see apps/api/src/lib/tenancy). The database default reads the session's app.clinic_id and
  /// fails when it is unset, so an insert that bypasses the scoped client cannot create a row that
  /// belongs to no clinic.
  clinicId String @default(dbgenerated("current_setting('app.clinic_id'::text)"))
  clinic   Clinic @relation(fields: [clinicId], references: [id])
  patientId  String
  signedDate String
  createdAt  DateTime          @default(now())
  pages      ConsentScanPage[]
  consents   Consent[]

  @@index([patientId])
  @@index([clinicId])
}

model ConsentScanPage {
  id       String      @id @default(uuid())
  scanId   String
  scan     ConsentScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  position Int
  filePath String

  @@unique([scanId, position])
}

