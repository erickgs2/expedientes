generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  language     String   @default("es")
  active       Boolean  @default(true)
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id     String           @id @default(uuid())
  module String
  action String
  roles  RolePermission[]

  @@unique([module, action])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Patient {
  id              String           @id @default(uuid())
  fullName        String
  /// Empty when the patient receives WhatsApp notices through `contactPatient` instead.
  phone           String
  documentId      String?
  /// Another patient — usually who they come with (partner, mother, daughter) — whose phone receives
  /// this patient's appointment confirmations and reminders. One level only: a contact never has a
  /// contact of their own. Cleared automatically if that patient is deleted.
  contactPatientId String?
  contactPatient   Patient?        @relation("NotificationContact", fields: [contactPatientId], references: [id], onDelete: SetNull)
  dependents       Patient[]       @relation("NotificationContact")
  historiaClinica HistoriaClinica?
  valoraciones    Valoracion[]
  treatments      Treatment[]
  appointments    Appointment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([fullName])
  @@index([phone])
  @@index([documentId])
  @@index([contactPatientId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String
  patientId String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([patientId])
  @@index([userId])
}

model HistoriaClinica {
  id        String  @id @default(uuid())
  patientId String  @unique
  patient   Patient @relation(fields: [patientId], references: [id])

  fecha DateTime @default(now())

  // Información del paciente
  ocupacion             String?
  fechaNacimiento       DateTime?
  sexo                  String?
  queQuiereElPaciente   String?
  queNecesitaElPaciente String?
  atributosEmocionales  String?

  // Información médica
  enfermedadesActuales        String?
  medicamentosAcne3Meses      String?
  cirugiasEsteticasAnteriores String?
  rutinaCuidadoFacial         String?

  // Antecedentes personales no patológicos
  consumoAlcohol          String?
  consumoTabaco           String?
  consumoDrogas           String?
  tipoFrecuenciaEjercicio String?
  vacunas                 String?
  posibilidadEmbarazo     String?

  // Antecedentes heredofamiliares
  antecedentesHeredofamiliares String?

  allergies HistoriaClinicaAllergy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Allergy {
  id        String                   @id @default(uuid())
  name      String                   @unique
  historias HistoriaClinicaAllergy[]
}

model HistoriaClinicaAllergy {
  historiaClinicaId String
  allergyId         String
  historiaClinica   HistoriaClinica @relation(fields: [historiaClinicaId], references: [id], onDelete: Cascade)
  allergy           Allergy         @relation(fields: [allergyId], references: [id], onDelete: Cascade)

  @@id([historiaClinicaId, allergyId])
}

model Valoracion {
  id        String  @id @default(uuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  fecha                 DateTime @default(now())
  queQuiereElPaciente   String?
  queNecesitaElPaciente String?
  notas                 String?

  diagrams ValoracionDiagram[]
  photos   Photo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
}

enum DiagramView {
  FRONT
  LEFT_PROFILE
  RIGHT_PROFILE
  // Close-ups of the front view, each with its own annotations.
  EYES
  NOSE
  LIPS
}

model ValoracionDiagram {
  id           String      @id @default(uuid())
  valoracionId String
  valoracion   Valoracion  @relation(fields: [valoracionId], references: [id])
  view         DiagramView
  data         Json
  updatedAt    DateTime    @updatedAt

  @@unique([valoracionId, view])
}

enum PhotoTag {
  BEFORE
  AFTER
}

model Photo {
  id           String     @id @default(uuid())
  patientId    String
  valoracionId String
  valoracion   Valoracion @relation(fields: [valoracionId], references: [id])
  tag          PhotoTag
  filePath     String
  createdAt    DateTime   @default(now())

  @@index([patientId])
  @@index([valoracionId])
}

model TreatmentType {
  id                       String                     @id @default(uuid())
  name                     String
  consentDescription       String
  consentRisks             String?
  consentAlternatives      String?
  consentAftercare         String?
  consentContraindications String?
  active                   Boolean                    @default(true)
  items                    TreatmentItem[]
  appointments             AppointmentTreatmentType[]
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
}

model Treatment {
  id        String          @id @default(uuid())
  patientId String
  patient   Patient         @relation(fields: [patientId], references: [id])
  fecha     DateTime        @default(now())
  items     TreatmentItem[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([patientId])
}

model TreatmentItem {
  id              String                 @id @default(uuid())
  treatmentId     String
  treatment       Treatment              @relation(fields: [treatmentId], references: [id])
  treatmentTypeId String
  treatmentType   TreatmentType          @relation(fields: [treatmentTypeId], references: [id])
  notes           String?
  consent         Consent?
  diagrams        TreatmentItemDiagram[]
  photos          TreatmentItemPhoto[]
  products        TreatmentItemProduct[]

  @@unique([treatmentId, treatmentTypeId])
}

enum ConsentSignatureMethod {
  DIGITAL
  PAPER
}

model Consent {
  id                        String                 @id @default(uuid())
  treatmentItemId           String                 @unique
  treatmentItem             TreatmentItem          @relation(fields: [treatmentItemId], references: [id])
  signatureMethod           ConsentSignatureMethod @default(DIGITAL)
  scanId                    String?
  scan                      ConsentScan?           @relation(fields: [scanId], references: [id])
  place                     String
  signedDateSnapshot        String
  patientNameSnapshot       String
  patientIdentification     String
  clinicNameSnapshot        String
  doctorTitleSnapshot       String
  doctorNameSnapshot        String
  doctorLicenseSnapshot     String
  declarationBeforeSnapshot String
  declarationAfterSnapshot  String
  sections                  Json
  patientSignatureImagePath String?
  witnessName               String?
  witnessSignatureImagePath String?
  signedAt                  DateTime               @default(now())

  @@index([scanId])
}

/// One scanned (photographed) set of pages carrying the handwritten signatures of one or more
/// consents signed the same day. `patientId` is a plain column, like TreatmentItemPhoto's.
model ConsentScan {
  id         String            @id @default(uuid())
  patientId  String
  signedDate String
  createdAt  DateTime          @default(now())
  pages      ConsentScanPage[]
  consents   Consent[]

  @@index([patientId])
}

model ConsentScanPage {
  id       String      @id @default(uuid())
  scanId   String
  scan     ConsentScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  position Int
  filePath String

  @@unique([scanId, position])
}

model TreatmentItemDiagram {
  id              String        @id @default(uuid())
  treatmentItemId String
  treatmentItem   TreatmentItem @relation(fields: [treatmentItemId], references: [id], onDelete: Cascade)
  view            DiagramView
  data            Json
  updatedAt       DateTime      @updatedAt

  @@unique([treatmentItemId, view])
}

model TreatmentItemPhoto {
  id              String        @id @default(uuid())
  treatmentItemId String
  treatmentItem   TreatmentItem @relation(fields: [treatmentItemId], references: [id], onDelete: Cascade)
  patientId       String
  tag             PhotoTag
  filePath        String
  createdAt       DateTime      @default(now())

  @@index([treatmentItemId])
  @@index([patientId])
}

model TreatmentItemProduct {
  id              String        @id @default(uuid())
  treatmentItemId String
  treatmentItem   TreatmentItem @relation(fields: [treatmentItemId], references: [id], onDelete: Cascade)
  patientId       String
  brand           String
  lotNumber       String
  expiryDate      DateTime?
  photoPath       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([treatmentItemId])
  @@index([lotNumber])
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id              String                     @id @default(uuid())
  patientId       String
  patient         Patient                    @relation(fields: [patientId], references: [id])
  startTime       DateTime
  durationMinutes Int
  status          AppointmentStatus          @default(SCHEDULED)
  notes           String?
  reminderSentAt  DateTime?
  /// When the booking-confirmation WhatsApp went out successfully. Null = never sent (or failed).
  confirmationSentAt DateTime?
  /// When reception registered that the patient arrived. Kept as a timestamp rather than a new
  /// `AppointmentStatus` so the calendar and the reminder sweep keep working unchanged.
  arrivedAt       DateTime?
  treatmentTypes  AppointmentTreatmentType[]
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([patientId])
  @@index([startTime])
}

model AppointmentTreatmentType {
  id              String        @id @default(uuid())
  appointmentId   String
  appointment     Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  treatmentTypeId String
  treatmentType   TreatmentType @relation(fields: [treatmentTypeId], references: [id])

  @@unique([appointmentId, treatmentTypeId])
}

model ClinicSettings {
  id                  String   @id @default("singleton")
  clinicName          String
  defaultPlace        String
  doctorTitle         String
  doctorName          String
  doctorLicense       String
  doctorSignaturePath String?
  clinicLogoPath      String?
  declarationBefore   String
  declarationAfter    String

  // WhatsApp appointment notifications (Meta Cloud API). Null/blank leaves the feature dormant.
  // `whatsappAccessToken` is a write-only secret: it is never returned by the settings API.
  whatsappAccessToken          String?
  whatsappPhoneNumberId        String?
  whatsappConfirmationTemplate String?
  whatsappReminderTemplate     String?
  whatsappTemplateLanguage     String?
  /// Master switch for messages sent to real patients (booking confirmation, automatic and manual
  /// reminders). Off by default so a clinic can configure and test the templates first; the
  /// settings screen's test sends ignore it, because they go to a number the user types.
  whatsappNotificationsEnabled Boolean @default(false)

  updatedAt           DateTime @updatedAt
}
