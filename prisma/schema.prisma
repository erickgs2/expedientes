generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A clinic or practice. Everything a clinic records (patients, records, catalog, settings, roles,
/// audit log) carries its clinicId, and no clinic can read another's rows.
model Clinic {
  id        String       @id @default(uuid())
  name      String
  phone     String?
  /// IANA time zone the clinic's day is computed in (the front desk, reminders, consent dates).
  timeZone  String       @default("America/Mexico_City")
  status    ClinicStatus @default(ACTIVE)

  // Optional tax details, kept for invoicing (CFDI) later.
  taxId         String?
  legalName     String?
  taxRegime     String?
  taxPostalCode String?

  /// Bytes of uploaded files this clinic holds, kept up to date as files are saved and deleted and
  /// recounted from the stored files when storageCountedAt is empty (see lib/plan/storage-usage.ts).
  storageBytes     BigInt    @default(0)
  storageCountedAt DateTime?
  /// The clinic's customer in Stripe, created on its first checkout and reused after.
  stripeCustomerId String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription          Subscription?
  planGrants            PlanGrant[]
  invitations           Invitation[]
  memberships           Membership[]
  settings              ClinicSettings?
  roles                 Role[]
  patients              Patient[]
  auditLogs             AuditLog[]
  historias             HistoriaClinica[]
  allergies             Allergy[]
  valoraciones          Valoracion[]
  valoracionDiagrams    ValoracionDiagram[]
  photos                Photo[]
  treatmentTypes        TreatmentType[]
  treatments            Treatment[]
  treatmentItems        TreatmentItem[]
  consents              Consent[]
  consentScans          ConsentScan[]
  treatmentItemDiagrams TreatmentItemDiagram[]
  treatmentItemPhotos   TreatmentItemPhoto[]
  treatmentItemProducts TreatmentItemProduct[]
  appointments          Appointment[]
  clinicalAddenda       ClinicalAddendum[]
  historiaRevisions     HistoriaClinicaRevision[]
}

enum ClinicStatus {
  ACTIVE
  SUSPENDED
}

enum PlanTier {
  FREE
  PREMIUM
}

enum BillingInterval {
  MONTH
  YEAR
}

enum SubscriptionStatus {
  /// Paid up to currentPeriodEnd.
  ACTIVE
  /// A card charge failed; Premium continues until graceEndsAt while Stripe retries.
  PAST_DUE
  /// Will not renew; Premium continues until currentPeriodEnd.
  CANCELED
}

enum PaymentMethod {
  CARD
  OXXO
}

/// A clinic's paid plan. Written only by the payment flow and the platform portal, never by a
/// clinic's own requests, so it is read and written through prismaUnscoped. A clinic with no row is
/// on Free unless a PlanGrant covers it.
model Subscription {
  id                   String             @id @default(uuid())
  clinicId             String             @unique
  clinic               Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  plan                 PlanTier           @default(PREMIUM)
  status               SubscriptionStatus
  interval             BillingInterval
  method               PaymentMethod
  currentPeriodEnd     DateTime
  graceEndsAt          DateTime?
  priceId              String?
  price                PlanPrice?         @relation(fields: [priceId], references: [id])
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  /// OXXO periods do not renew on their own: when the owner was reminded 7 days and 1 day before.
  renewalNotice7SentAt DateTime?
  renewalNotice1SentAt DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

/// Premium given by hand from the platform portal, for a number of months. Never touches the
/// subscription or Stripe. Expiry is computed when the plan is read, so nothing has to run when a
/// grant ends.
model PlanGrant {
  id            String    @id @default(uuid())
  clinicId      String
  clinic        Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  plan          PlanTier  @default(PREMIUM)
  startsAt      DateTime
  endsAt        DateTime
  months        Int
  reason        String
  /// Who granted it: a platform admin id, or "migration" for the founder grant.
  grantedBy     String
  createdAt     DateTime  @default(now())
  revokedAt     DateTime?
  revokedBy     String?
  revokedReason String?
  /// When the owner was told the grant ends in 7 days, so the notice goes out once.
  endingNoticeSentAt DateTime?

  @@index([clinicId, endsAt])
}

/// One version of the Premium price. Never edited: a change is a new row, so every past charge keeps
/// the price it was made at. The current price is the latest row whose effectiveFrom has passed.
model PlanPrice {
  id                    String         @id @default(uuid())
  /// Monthly price in centavos, IVA included.
  monthlyCents          Int
  /// Discount for paying a year at once, in whole percent.
  annualDiscountPercent Int
  /// monthly × 12 × (1 − discount), rounded to whole pesos, in centavos.
  annualCents           Int
  stripeMonthlyPriceId  String?
  stripeAnnualPriceId   String?
  effectiveFrom         DateTime       @default(now())
  createdBy             String
  createdAt             DateTime       @default(now())
  subscriptions         Subscription[]

  @@index([effectiveFrom])
}

/// A user's access to one clinic, with the role they hold there. A user (one email, one password)
/// may belong to several clinics; what they can do is decided per clinic.
model Membership {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  /// The person who registered the clinic and manages its plan.
  isOwner   Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, clinicId])
  @@index([clinicId])
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  language     String   @default("es")
  active       Boolean  @default(true)
  /// Legacy, from before memberships: what a user can do now depends on the clinic, and lives in
  /// Membership.roleId. Kept nullable until a later migration drops it.
  roleId       String?
  role         Role?    @relation(fields: [roleId], references: [id])
  memberships  Membership[]
  legalAcceptances TermsAcceptance[]
  invitationsSent  Invitation[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  /// Shown with every note this user signs (NOM-004-SSA3-2012 5.10). The licence is the cédula
  /// profesional; a user without one cannot sign notes.
  professionalTitle   String?
  professionalLicense String?
  /// bcrypt hash of the 6-digit PIN used to sign notes. Set by the user, never shown.
  signingPinHash      String?
}

model Role {
  id          String           @id @default(uuid())
  /// The clinic this row belongs to. Every query on this model is scoped to the current clinic
  /// (see apps/api/src/lib/tenancy). The database default reads the session's app.clinic_id and
  /// fails when it is unset, so an insert that bypasses the scoped client cannot create a row that
  /// belongs to no clinic.
  clinicId String @default(dbgenerated("current_setting('app.clinic_id'::text)"))
  clinic   Clinic @relation(fields: [clinicId], references: [id])
  name        String
  /// Legacy: User.roleId from before memberships. Kept until a later migration drops it.
  users       User[]
  memberships Membership[]
  invitations Invitation[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([clinicId, name])
}

model Permission {
  id     String           @id @default(uuid())
  module String
  action String
  roles  RolePermission[]

  @@unique([module, action])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Patient {
  id              String           @id @default(uuid())
  /// The clinic this row belongs to. Every query on this model is scoped to the current clinic
  /// (see apps/api/src/lib/tenancy). The database default reads the session's app.clinic_id and
  /// fails when it is unset, so an insert that bypasses the scoped client cannot create a row that
  /// belongs to no clinic.
  clinicId String @default(dbgenerated("current_setting('app.clinic_id'::text)"))
  clinic   Clinic @relation(fields: [clinicId], references: [id])
  fullName        String
  /// Empty when the patient receives WhatsApp notices through `contactPatient` instead.
  phone           String
  documentId      String?
  /// Another patient — usually who they come with (partner, mother, daughter) — whose phone receives
  /// this patient's appointment confirmations and reminders. One level only: a contact never has a
  /// contact of their own. Cleared automatically if that patient is deleted.
  contactPatientId String?
  contactPatient   Patient?        @relation("NotificationContact", fields: [contactPatientId], references: [id], onDelete: SetNull)
  dependents       Patient[]       @relation("NotificationContact")
  historiaClinica HistoriaClinica?
  valoraciones    Valoracion[]
  treatments      Treatment[]
  appointments    Appointment[]
  addenda         ClinicalAddendum[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  /// Archived instead of deleted (NOM-004-SSA3-2012 5.4: a record is kept at least five years
  /// after the last care). An archived patient leaves every work list, reads read-only, and can be
  /// restored; only the clinic owner can purge it for good, and only five years after the last care.
  archivedAt      DateTime?
  archivedById    String?
  archiveReason   String?

  @@index([fullName])
  @@index([clinicId, fullName])
  @@index([phone])
  @@index([documentId])
  @@index([contactPatientId])
  @@index([clinicId, archivedAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  /// The clinic this row belongs to. Every query on this model is scoped to the current clinic
  /// (see apps/api/src/lib/tenancy). The database default reads the session's app.clinic_id and
  /// fails when it is unset, so an insert that bypasses the scoped client cannot create a row that
  /// belongs to no clinic.
  clinicId String @default(dbgenerated("current_setting('app.clinic_id'::text)"))
  clinic   Clinic @relation(fields: [clinicId], references: [id])
  userId    String
  action    String
  entity    String
  entityId  String
  patientId String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([patientId])
  @@index([userId])
  @@index([clinicId])
}

model HistoriaClinica {
  id        String  @id @default(uuid())
  /// The clinic this row belongs to. Every query on this model is scoped to the current clinic
  /// (see apps/api/src/lib/tenancy). The database default reads the session's app.clinic_id and
  /// fails when it is unset, so an insert that bypasses the scoped client cannot create a row that
  /// belongs to no clinic.
  clinicId String @default(dbgenerated("current_setting('app.clinic_id'::text)"))
  clinic   Clinic @relation(fields: [clinicId], references: [id])
  patientId String  @unique
  patient   Patient @relation(fields: [patientId], references: [id])

  fecha DateTime @default(now())

  // Información del paciente
  ocupacion             String?
  fechaNacimiento       DateTime?
  sexo                  String?
  queQuiereElPaciente   String?
  queNecesitaElPaciente String?
  atributosEmocionales  String?

  // Información médica
  enfermedadesActuales        String?
  medicamentosAcne3Meses      String?
  cirugiasEsteticasAnteriores String?
  rutinaCuidadoFacial         String?

  // Antecedentes personales no patológicos
  consumoAlcohol          String?
  consumoTabaco           String?
  consumoDrogas           String?
  tipoFrecuenciaEjercicio String?
  vacunas                 String?
  posibilidadEmbarazo     String?

  // Antecedentes heredofamiliares
  antecedentesHeredofamiliares String?

  allergies HistoriaClinicaAllergy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// NOM-004-SSA3-2012 5.10: who wrote the note and who signed it (electronic signature with the
  /// author's signing PIN). The signer's name, title and licence are frozen at signing, with a
  /// SHA-256 of the note's content. Editing a signed note voids the signature. `legacyRecord` marks
  /// notes written before electronic signatures existed; they are never signed retroactively.
  createdById   String?
  signedById    String?
  signedAt      DateTime?
  signedHash    String?
  signerName    String?
  signerTitle   String?
  signerLicense String?
  legacyRecord  Boolean   @default(false)

  @@index([clinicId])
  revisions HistoriaClinicaRevision[]
}

model Allergy {
  id        String                   @id @default(uuid())
  /// The clinic this row belongs to. Every query on this model is scoped to the current clinic
  /// (see apps/api/src/lib/tenancy). The database default reads the session's app.clinic_id and
  /// fails when it is unset, so an insert that bypasses the scoped client cannot create a row that
  /// belongs to no clinic.
  clinicId String @default(dbgenerated("current_setting('app.clinic_id'::text)"))
  clinic   Clinic @relation(fields: [clinicId], references: [id])
  name      String
  historias HistoriaClinicaAllergy[]

  @@unique([clinicId, name])
}

model HistoriaClinicaAllergy {
  historiaClinicaId String
  allergyId         String
  historiaClinica   HistoriaClinica @relation(fields: [historiaClinicaId], references: [id], onDelete: Cascade)
  allergy           Allergy         @relation(fields: [allergyId], references: [id], onDelete: Cascade)

  @@id([historiaClinicaId, allergyId])
}

model Valoracion {
  id        String  @id @default(uuid())
  /// The clinic this row belongs to. Every query on this model is scoped to the current clinic
  /// (see apps/api/src/lib/tenancy). The database default reads the session's app.clinic_id and
  /// fails when it is unset, so an insert that bypasses the scoped client cannot create a row that
  /// belongs to no clinic.
  clinicId String @default(dbgenerated("current_setting('app.clinic_id'::text)"))
  clinic   Clinic @relation(fields: [clinicId], references: [id])
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  fecha                 DateTime @default(now())
  queQuiereElPaciente   String?
  queNecesitaElPaciente String?
  notas                 String?

  diagrams ValoracionDiagram[]
  photos   Photo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// NOM-004-SSA3-2012 5.10: who wrote the note and who signed it (electronic signature with the
  /// author's signing PIN). The signer's name, title and licence are frozen at signing, with a
  /// SHA-256 of the note's content. Editing a signed note voids the signature. `legacyRecord` marks
  /// notes written before electronic signatures existed; they are never signed retroactively.
  createdById   String?
  signedById    String?
  signedAt      DateTime?
  signedHash    String?
  signerName    String?
  signerTitle   String?
  signerLicense String?
  legacyRecord  Boolean   @default(false)

  @@index([patientId])
  @@index([clinicId])
  @@index([createdById, signedAt])
}

enum DiagramView {
  FRONT
  LEFT_PROFILE
  RIGHT_PROFILE
  // Close-ups of the front view, each with its own annotations.
  EYES
  NOSE
  LIPS
}

model ValoracionDiagram {
  id           String      @id @default(uuid())
  /// The clinic this row belongs to. Every query on this model is scoped to the current clinic
  /// (see apps/api/src/lib/tenancy). The database default reads the session's app.clinic_id and
  /// fails when it is unset, so an insert that bypasses the scoped client cannot create a row that
  /// belongs to no clinic.
  clinicId String @default(dbgenerated("current_setting('app.clinic_id'::text)"))
  clinic   Clinic @relation(fields: [clinicId], references: [id])
  valoracionId String
  valoracion   Valoracion  @relation(fields: [valoracionId], references: [id])
  view         DiagramView
  data         Json
  updatedAt    DateTime    @updatedAt

  @@unique([valoracionId, view])
  @@index([clinicId])
}

enum PhotoTag {
  BEFORE
  AFTER
}

model Photo {
  id           String     @id @default(uuid())
  /// The clinic this row belongs to. Every query on this model is scoped to the current clinic
