  /// fails when it is unset, so an insert that bypasses the scoped client cannot create a row that
  /// belongs to no clinic.
  clinicId String @default(dbgenerated("current_setting('app.clinic_id'::text)"))
  clinic   Clinic @relation(fields: [clinicId], references: [id])
  patientId    String
  valoracionId String
  valoracion   Valoracion @relation(fields: [valoracionId], references: [id])
  tag          PhotoTag
  filePath     String
  createdAt    DateTime   @default(now())
  /// Retired from the gallery instead of deleted: the file stays and the photo can be put back.
  archivedAt   DateTime?
  archivedById String?

  @@index([patientId])
  @@index([valoracionId])
  @@index([clinicId])
}

