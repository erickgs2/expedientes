  updatedAt       DateTime      @updatedAt

  @@index([treatmentItemId])
  @@index([lotNumber])
  @@index([clinicId])
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id              String                     @id @default(uuid())
  /// The clinic this row belongs to. Every query on this model is scoped to the current clinic
  /// (see apps/api/src/lib/tenancy). The database default reads the session's app.clinic_id and
  /// fails when it is unset, so an insert that bypasses the scoped client cannot create a row that
  /// belongs to no clinic.
  clinicId String @default(dbgenerated("current_setting('app.clinic_id'::text)"))
  clinic   Clinic @relation(fields: [clinicId], references: [id])
  patientId       String
  patient         Patient                    @relation(fields: [patientId], references: [id])
  startTime       DateTime
  durationMinutes Int
  status          AppointmentStatus          @default(SCHEDULED)
  notes           String?
  reminderSentAt  DateTime?
  /// When the booking-confirmation WhatsApp went out successfully. Null = never sent (or failed).
  confirmationSentAt DateTime?
  /// When reception registered that the patient arrived. Kept as a timestamp rather than a new
  /// `AppointmentStatus` so the calendar and the reminder sweep keep working unchanged.
  arrivedAt       DateTime?
  treatmentTypes  AppointmentTreatmentType[]
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([patientId])
  @@index([startTime])
  @@index([clinicId, startTime])
}

model AppointmentTreatmentType {
  id              String        @id @default(uuid())
  appointmentId   String
  appointment     Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  treatmentTypeId String
  treatmentType   TreatmentType @relation(fields: [treatmentTypeId], references: [id])

  @@unique([appointmentId, treatmentTypeId])
}

model ClinicSettings {
  id                  String   @id @default(uuid())
  /// The clinic this row belongs to. Every query on this model is scoped to the current clinic
  /// (see apps/api/src/lib/tenancy). The database default reads the session's app.clinic_id and
  /// fails when it is unset, so an insert that bypasses the scoped client cannot create a row that
  /// belongs to no clinic.
  clinicId String @unique @default(dbgenerated("current_setting('app.clinic_id'::text)"))
  clinic   Clinic @relation(fields: [clinicId], references: [id])
  clinicName          String
  defaultPlace        String
  doctorTitle         String
  doctorName          String
  doctorLicense       String
  doctorSignaturePath String?
  clinicLogoPath      String?
  /// Who usually signs as the second witness of a consent (a clinic staff member), offered
  /// pre-filled at signing. The signature image is copied onto each consent when it is used, so a
  /// later change here never alters a signed one.
  secondWitnessName          String?
  secondWitnessSignaturePath String?
  declarationBefore   String
  declarationAfter    String

  // WhatsApp appointment notifications (Meta Cloud API). Null/blank leaves the feature dormant.
  // `whatsappAccessToken` is a write-only secret: it is never returned by the settings API.
  whatsappAccessToken          String?
  whatsappPhoneNumberId        String?
  whatsappConfirmationTemplate String?
  whatsappReminderTemplate     String?
  whatsappTemplateLanguage     String?
  /// Master switch for messages sent to real patients (booking confirmation, automatic and manual
  /// reminders). Off by default so a clinic can configure and test the templates first; the
  /// settings screen's test sends ignore it, because they go to a number the user types.
  whatsappNotificationsEnabled Boolean @default(false)

  updatedAt           DateTime @updatedAt
}

/// A registration waiting for its email code. No user or clinic exists until the code is confirmed;
/// confirming creates both in one transaction. One row per email: registering again replaces it.
model PendingSignup {
  id                String   @id @default(uuid())
  email             String   @unique
  passwordHash      String
  fullName          String
  clinicName        String
  phone             String
  /// The legal document versions shown and accepted on the form.
  privacyDocumentId String
  termsDocumentId   String
  marketingConsent  Boolean  @default(false)
  codeHash          String
  codeExpiresAt     DateTime
  attempts          Int      @default(0)
  /// Sends in the current hour window, for the resend cap.
  sendCount         Int      @default(1)
  sendWindowStart   DateTime @default(now())
  lastSentAt        DateTime @default(now())
  ip                String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// A password-reset code sent to a user's email. One row per user: requesting again replaces it.
model PasswordResetCode {
  id              String   @id @default(uuid())
  userId          String   @unique
  codeHash        String
  codeExpiresAt   DateTime
  attempts        Int      @default(0)
  sendCount       Int      @default(1)
  sendWindowStart DateTime @default(now())
  lastSentAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// An invitation to join a clinic with a role. The account (or, for an existing account, the
/// membership) is created only when the invitee accepts from the emailed link, so a clinic cannot
/// claim someone else's email.
model Invitation {
  id          String    @id @default(uuid())
  /// The clinic this row belongs to. Every query on this model is scoped to the current clinic
  /// (see apps/api/src/lib/tenancy). The database default reads the session's app.clinic_id and
  /// fails when it is unset, so an insert that bypasses the scoped client cannot create a row that
  /// belongs to no clinic.
  clinicId    String    @default(dbgenerated("current_setting('app.clinic_id'::text)"))
  clinic      Clinic    @relation(fields: [clinicId], references: [id])
  email       String
  roleId      String
  role        Role      @relation(fields: [roleId], references: [id])
  /// SHA-256 of the token in the link; the token itself is never stored.
  tokenHash   String    @unique
  invitedById String
  invitedBy   User      @relation(fields: [invitedById], references: [id])
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([clinicId])
}

enum LegalDocumentKind {
  PRIVACY
  TERMS
}

/// One published version of the privacy notice or the terms. Never edited: a change is a new
/// version. The one in force is the latest whose effectiveFrom has passed.
model LegalDocument {
  id                 String            @id @default(uuid())
  kind               LegalDocumentKind
  version            String
  /// Markdown (the subset in libs/shared/types/src/lib/legal-markdown.ts).
  body               String
  changeSummary      String
  effectiveFrom      DateTime
  /// Users who have not accepted this version are asked to before they can go on.
  requiresAcceptance Boolean           @default(false)
  publishedBy        String
  createdAt          DateTime          @default(now())
  acceptances        TermsAcceptance[]

  @@unique([kind, version])
  @@index([kind, effectiveFrom])
}

/// That a user accepted a version of a legal document, when and from where.
model TermsAcceptance {
  id               String        @id @default(uuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId       String
  document         LegalDocument @relation(fields: [documentId], references: [id])
  /// For the privacy notice: whether the additional purposes (promotions, surveys) were accepted.
  marketingConsent Boolean       @default(false)
  ip               String?
  userAgent        String?
  acceptedAt       DateTime      @default(now())

  @@unique([userId, documentId])
  @@index([documentId])
}

/// The operator of the whole service (you), separate from every clinic's users: own table, own
/// sign-in at /plataforma, own cookie, and a TOTP second factor that is required.
model PlatformAdmin {
  id              String              @id @default(uuid())
  email           String              @unique
  passwordHash    String
  fullName        String
  /// TOTP secret, encrypted with AES-256-GCM (lib/platform/secret-box.ts). Set during enrolment;
  /// only trusted once totpEnabledAt is set.
  totpSecret      String?
  totpEnabledAt   DateTime?
  /// Last 30-second step accepted, so a code cannot be used twice.
  totpLastStep    Int?
  active          Boolean             @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  auditLogs       PlatformAuditLog[]
}

/// Every action taken from the platform portal.
model PlatformAuditLog {
  id         String        @id @default(uuid())
  adminId    String
  admin      PlatformAdmin @relation(fields: [adminId], references: [id])
  /// e.g. "clinic.suspend", "grant.create", "price.create", "legal.publish", "session.login"
  action     String
  targetType String?
  targetId   String?
  details    Json?
  ip         String?
  createdAt  DateTime      @default(now())

  @@index([createdAt])
}

/// A sample of the server's load for the portal's charts: one every 5 minutes, kept 7 days.
model ServerMetricSample {
  id              String   @id @default(uuid())
  takenAt         DateTime @default(now())
  cpuPercent      Float
  memUsedBytes    BigInt
  memTotalBytes   BigInt
  diskUsedBytes   BigInt
  diskTotalBytes  BigInt
  dbSizeBytes     BigInt
  processRssBytes BigInt

  @@index([takenAt])
}

/// A Stripe webhook event already applied, by its Stripe id, so a redelivered event changes
/// nothing; also the payment history shown in the portal.
model PaymentEvent {
  id          String   @id
  type        String
  clinicId    String?
  /// Amount charged, in centavos, when the event is a payment.
  amountCents Int?
  summary     String?
  receivedAt  DateTime @default(now())

  @@index([clinicId, receivedAt])
}

/// NOM-004-SSA3-2012 5.10: a signed valoración or treatment visit is never edited; a correction or
/// later finding is added as an addendum, written and signed in one step and itself never edited or
/// deleted. `entity` is the note kind ('valoracion' | 'treatment'); `diagrams` holds the addendum's
/// own diagram views ([{view, data}]) when the correction is drawn.
model ClinicalAddendum {
  id            String   @id @default(uuid())
  /// The clinic this row belongs to. Every query on this model is scoped to the current clinic
  /// (see apps/api/src/lib/tenancy). The database default reads the session's app.clinic_id and
  /// fails when it is unset, so an insert that bypasses the scoped client cannot create a row that
  /// belongs to no clinic.
  clinicId      String   @default(dbgenerated("current_setting('app.clinic_id'::text)"))
  clinic        Clinic   @relation(fields: [clinicId], references: [id])
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id])
  entity        String
  entityId      String
  text          String
  diagrams      Json?
  createdById   String
  createdAt     DateTime @default(now())
  signedById    String
  signedAt      DateTime
  contentHash   String
  signerName    String
  signerTitle   String?
  signerLicense String

  @@index([entity, entityId])
  @@index([patientId])
}

/// NOM-004-SSA3-2012 5.10 for the historia clínica, which is updated over time instead of locked:
/// every save keeps the full content as a numbered revision, and signing signs the latest one.
/// Revisions are never edited. Revision 1 of a historia that existed before this table is
/// `legacyRecord` (author unknown, never signed).
model HistoriaClinicaRevision {
  id                String          @id @default(uuid())
  /// The clinic this row belongs to. Every query on this model is scoped to the current clinic
  /// (see apps/api/src/lib/tenancy). The database default reads the session's app.clinic_id and
  /// fails when it is unset, so an insert that bypasses the scoped client cannot create a row that
  /// belongs to no clinic.
  clinicId          String          @default(dbgenerated("current_setting('app.clinic_id'::text)"))
  clinic            Clinic          @relation(fields: [clinicId], references: [id])
  historiaClinicaId String
  historiaClinica   HistoriaClinica @relation(fields: [historiaClinicaId], references: [id])
  revision          Int
  content           Json
  contentHash       String
  changedById       String?
  changedAt         DateTime        @default(now())
  legacyRecord      Boolean         @default(false)
  signedById        String?
  signedAt          DateTime?
  signerName        String?
  signerTitle       String?
  signerLicense     String?

  @@unique([historiaClinicaId, revision])
}
