{
  "mcpServers": {
    "nx-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "nx",
        "mcp"
      ]
    }
  },
  "contextFileName": "AGENTS.md",
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "^run_shell_command$",
        "hooks": [
          {
            "name": "impeccable-session",
            "type": "command",
            "command": "[ ! -f '/Users/egarsev/.gemini/skills/impeccable/scripts/impeccable' ] || '/Users/egarsev/.gemini/skills/impeccable/scripts/impeccable' hook",
            "timeout": 5000
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "name": "impeccable-completion",
            "type": "command",
            "command": "[ ! -f '/Users/egarsev/.gemini/skills/impeccable/scripts/impeccable' ] || '/Users/egarsev/.gemini/skills/impeccable/scripts/impeccable' hook",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}
