DATABASE_URL="postgresql://username:password@localhost:5432/expedientes"
JWT_SECRET="change-me-in-production"
STORAGE_ROOT="./storage"
SEED_ADMIN_EMAIL="admin@clinic.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Only used by docker-compose.prod.yml (the containerized Postgres). Local development connects to
# the native Postgres server through DATABASE_URL above and ignores these. `docker compose up`
# fails fast if these or JWT_SECRET are unset.
POSTGRES_USER="expedientes"
POSTGRES_PASSWORD="change-me-in-production"

# WhatsApp booking notifications (Meta Cloud API). Leave unset in development — the feature
# silently no-ops (logs one warning, sends nothing) when these are missing, so local dev works
# without real Meta credentials.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_CONFIRMATION_TEMPLATE="appointment_confirmation"
WHATSAPP_REMINDER_TEMPLATE="appointment_reminder"
WHATSAPP_TEMPLATE_LANGUAGE="es_MX"
