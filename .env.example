DATABASE_URL="postgresql://username:password@localhost:5432/expedientes"
JWT_SECRET="change-me-in-production"
STORAGE_ROOT="./storage"

# Object storage for patient images. Leave STORAGE_S3_BUCKET unset for local development and the
# app writes to STORAGE_ROOT on disk; set it and every upload goes to S3 instead, with the stored
# path used unchanged as the object key (no database migration when a deployment switches).
# Credentials are never configured here — deployments use an EC2 instance role.
STORAGE_S3_BUCKET=""
AWS_REGION="mx-central-1"
SEED_ADMIN_EMAIL="admin@clinic.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Only used by docker-compose.prod.yml (the containerized Postgres). Local development connects to
# the native Postgres server through DATABASE_URL above and ignores these. `docker compose up`
# fails fast if these or JWT_SECRET are unset.
POSTGRES_USER="expedientes"
POSTGRES_PASSWORD="change-me-in-production"

# WhatsApp booking notifications (Meta Cloud API).
#
# These are now configurable in the app, under Datos de la clínica (/admin/clinic), which is the
# recommended place: changing them there needs no redeploy. What is stored there WINS over what is
# set here. These remain supported so an existing deployment keeps working, and so the token can be
# injected by a secret manager instead of typed into a form.
#
# Leave unset in development — the feature silently no-ops (logs one warning, sends nothing) when
# no token / phone number id is configured from either source.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_CONFIRMATION_TEMPLATE="appointment_confirmation"
WHATSAPP_REMINDER_TEMPLATE="appointment_reminder"
WHATSAPP_TEMPLATE_LANGUAGE="es_MX"
